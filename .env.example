# Pixiv refresh token，可通过 GET /api/auth/login-url 网页授权或 POST /api/auth/login 获取
PIXIV_REFRESH_TOKEN=
PIXIV_BRIDGE_HOST=127.0.0.1
PIXIV_BRIDGE_PORT=8765
PIXIV_RATE_LIMIT_RPM=100
PIXIV_ACCEPT_LANGUAGE=zh-CN
PIXIV_REQUEST_TIMEOUT=30
# 个人数据目录：token / 阅读历史 / 下载记录 / 收藏台账 / 页面配置都在里面（换机拷这一个目录）
# 相对路径按项目根目录算；老版本的 tokens.json / history.jsonl 会在首次启动时自动搬进来
# 只支持项目目录内：写成项目外的路径（安卓上例如 /sdcard/...）会被自动改回项目里的 data/，
# 启动日志与设置页会逐条提示（项目外目录常读得到写不进，保存配置就会 500）
PIXIV_DATA_DIR=data
PIXIV_TOKEN_FILE=data/tokens.json
# 阅读历史文件（个人使用，一行一条 JSON）
PIXIV_HISTORY_FILE=data/history.jsonl
# 下载历史（按章节记：「书号#章号」为一条）
PIXIV_DOWNLOADS_FILE=data/downloads.jsonl
# 收藏台账（取消收藏写一条墓碑行）
PIXIV_BOOKMARKS_FILE=data/bookmarks.jsonl
# 页面配置（本地书架目录、合并同名系列 / 跳过已下载开关、扫描层数），由页面「Aa → 书架与下载」写入
PIXIV_CONFIG_FILE=data/settings.json
# 直连（SNI 绕过）相关，详见 README「直连模式」
PIXIV_BRIDGE_BYPASS_SNI=0
PIXIV_BRIDGE_API_IPS=
PIXIV_BRIDGE_OAUTH_IPS=
PIXIV_BRIDGE_IMAGE_IPS=
# ECH 模式（推荐用于 SNI 被封锁的网络，需要 OpenSSL 3.5+ 的 libssl），详见 README「ECH 模式」
PIXIV_BRIDGE_ECH=0
# 留空则自动通过 DoH 获取 Cloudflare 的 ECH 配置
PIXIV_BRIDGE_ECH_CONFIG=
# 留空则使用内置 Cloudflare 入口 IP 池
PIXIV_BRIDGE_ECH_IPS=
# ECH 需要 OpenSSL 3.5+ 的 libssl/libcrypto；留空则按 PATH → 常见安装路径自动查找
PIXIV_BRIDGE_OPENSSL_DIR=
# 代理（如 http://127.0.0.1:7890）：设置后所有 Pixiv 请求都走代理，不再使用 ECH / SNI 绕过。
# ECH 被运营商阻断时这是唯一可用的替代方案；socks5:// 需要先 pip install "httpx[socks]"
PIXIV_PROXY=
# 依赖自动安装时使用的 pip 镜像源，留空则自动尝试清华 / 阿里云 / 官方
PIXIV_BRIDGE_PIP_INDEX=
