# Pixiv refresh token，可通过 GET /api/auth/login-url 网页授权或 POST /api/auth/login 获取
PIXIV_REFRESH_TOKEN=
PIXIV_BRIDGE_HOST=127.0.0.1
PIXIV_BRIDGE_PORT=8765
PIXIV_RATE_LIMIT_RPM=100
PIXIV_ACCEPT_LANGUAGE=zh-CN
PIXIV_REQUEST_TIMEOUT=30
# 个人数据目录：token / 阅读历史 / 下载记录 / 收藏台账 / 页面配置都在里面（换机拷这一个目录）
# 相对路径按项目根目录算；老版本的 tokens.json / history.jsonl 会在首次启动时自动搬进来
# 只支持项目目录内：写成项目外的路径（安卓上例如 /sdcard/...）会被自动改回项目里的 data/，
# 启动日志与设置页会逐条提示（项目外目录常读得到写不进，保存配置就会 500）
PIXIV_DATA_DIR=data
PIXIV_TOKEN_FILE=data/tokens.json
# 阅读历史文件（个人使用，一行一条 JSON）
PIXIV_HISTORY_FILE=data/history.jsonl
# 下载历史（按章节记：「书号#章号」为一条）
PIXIV_DOWNLOADS_FILE=data/downloads.jsonl
# 收藏台账（取消收藏写一条墓碑行）
PIXIV_BOOKMARKS_FILE=data/bookmarks.jsonl
# 页面配置（本地书架目录、合并同名系列 / 跳过已下载开关、扫描层数），由页面「Aa → 书架与下载」写入
PIXIV_CONFIG_FILE=data/settings.json
# 附属项目（扩展）：写目录的相对路径即可挂上，程序去该目录下找固定文件名 extension.py。
# 留空 = 只跑纯接口，一个扩展都不装。
# 例：PIXIV_BRIDGE_EXTENSIONS=novel  会把 novel/ 的阅读器与书架接口挂到本接口项目上
#     （原来的 python novel/run.py 入口已取消，改用这一行）。
#     PIXIV_BRIDGE_EXTENSIONS=iwara_web  会把 iwara_web/ 的视频页面挂到 /iwara
#     （它调 /api/iwara/*，所以要配合 iwara/run.py 入口用）。
# 多个用逗号分隔，按顺序挂载：PIXIV_BRIDGE_EXTENSIONS=novel,iwara_web
PIXIV_BRIDGE_EXTENSIONS=
# 导航页（`/`，恒定提供）上的「其它入口」段：写成 标题=地址，多项用逗号 / 分号 / 换行分隔。
# 用来把另一个入口列到手边，例如 iwara 的入口：PIXIV_BRIDGE_NAV_LINKS=iwara 视频=http://127.0.0.1:8766/
# 只写地址时拿地址当标题；留空就没有这一段。
PIXIV_BRIDGE_NAV_LINKS=
# 直连（SNI 绕过）相关，详见 README「直连模式」
PIXIV_BRIDGE_BYPASS_SNI=0
PIXIV_BRIDGE_API_IPS=
PIXIV_BRIDGE_OAUTH_IPS=
PIXIV_BRIDGE_IMAGE_IPS=
# ECH 模式（推荐用于 SNI 被封锁的网络；OpenSSL 4.0+ 的库已随项目自带，无需另装），详见 README「ECH 模式」
PIXIV_BRIDGE_ECH=0
# 留空则自动通过 DoH 获取 Cloudflare 的 ECH 配置
PIXIV_BRIDGE_ECH_CONFIG=
# 留空则使用内置 Cloudflare 入口 IP 池
PIXIV_BRIDGE_ECH_IPS=
# 含 OpenSSL 4.0+ 的 libssl/libcrypto 的目录（ECH 是 4.0.0 才加入的，3.x 全系没有）；
# 留空则优先用项目自带的 openssl-libs/，再退回系统安装位置（openssl 可执行文件旁 / PATH / 常见安装路径）。
# 填了则优先用它。
PIXIV_BRIDGE_OPENSSL_DIR=
# 代理（如 http://127.0.0.1:7890）：设置后所有 Pixiv 请求都走代理，不再使用 ECH / SNI 绕过。
# ECH 被运营商阻断时这是唯一可用的替代方案；socks5:// 需要先 pip install "httpx[socks]"
PIXIV_PROXY=
# 依赖自动安装时使用的 pip 镜像源，留空则自动尝试清华 / 阿里云 / 官方
PIXIV_BRIDGE_PIP_INDEX=
# iwara 的 ECH（加密 SNI），可选。走 curl_cffi 的 libcurl，不需要 OpenSSL 动态库；
# 只影响 api.iwara.tv / www.iwara.tv 这两个在 Cloudflare 后的主机（视频 CDN 不在 CF 后，用不了）。
IWARA_BRIDGE_ECH=0
# 留空则自动通过 DoH（阿里 → 223.5.5.5）获取 Cloudflare 的 ECH 配置
IWARA_BRIDGE_ECH_CONFIG=
# 留空则只用内置种子 IP；填了会额外追加（排在种子之后）
IWARA_BRIDGE_ECH_IPS=
# iwara 登录态（可选，只有 iwara/run.py 入口用得到）。
# 公开内容（含 R18）匿名就能看，登录只为「订阅作者的内容」和自己账号下的私密视频。
# 正常留空即可：跑一次 python iwara/get_token.py 会把 token 存到 data/iwara_tokens.json，
# 那里存了就用那里的。填了则优先用它（临时用别的账号跑一次，不必覆盖本机文件）。
IWARA_REFRESH_TOKEN=
# asmr.one 的 ECH（加密 SNI）。走 curl_cffi 的 libcurl，不需要 OpenSSL 动态库；
# 只影响 api.asmr.one / www.asmr.one / raw.kiko-play-niptan.one 这几个在 Cloudflare 后的主机。
# 注意：与 iwara 相反，这里**不写这个变量就是开**（asmr 的 Cloudflare 边缘不带 ECH 会被拦）；
# 只有想显式关掉时才写 ASMR_BRIDGE_ECH=0（0/false/no/off）。
ASMR_BRIDGE_ECH=1
# 留空则自动通过 DoH（阿里 → 223.5.5.5）获取 Cloudflare 的 ECH 配置，失败用内置默认值
ASMR_BRIDGE_ECH_CONFIG=
# 留空则只用内置种子 IP；填了会额外追加（排在种子之后）
ASMR_BRIDGE_ECH_IPS=
# asmr.one 不需要登录：浏览 / 搜索 / 播放匿名就够，所以没有 token 与 get_token.py。
# E-Hentai（ehviewer/run.py 入口）的 HTTP/3。走 curl_cffi 的 libcurl，不需要 OpenSSL 动态库。
# 注意：这里**默认就是开**，不写这个变量等于开。e-hentai.org 自己解析出来的那几个边缘 IP 在本机
# 被 IP 级阻断，必须借道别的 Cloudflare anycast IP（内置 16 个候选），且 HTTPS/1.1 与 HTTP/2
# 会因 SNI 不符被拒——只有 QUIC（UDP:443）不受那个判据限制。关掉大概率整个站不通。
# 只有想显式关掉时才写 EH_BRIDGE_HTTP3=0（0/false/no/off）。
EH_BRIDGE_HTTP3=1
# 覆盖内置的 16 个候选 anycast IP（逗号分隔）。内置表里故意排除了 e-hentai 自己解析出的
# 那两个被阻断的地址（172.66.132.196 / 172.66.140.62），换网络后可以在这里补自己实测可用的。
EH_BRIDGE_EDGE_IPS=
# 一次请求最多换几个边缘 IP 重试（默认 5：轮转游标，不是死磕同一个）
EH_BRIDGE_EDGE_ATTEMPTS=5
# 图片代转时最多重新解析几次 /s/ 页去拿新的 H@H 节点（默认 4；节点会失效，老失败就调大）
EH_BRIDGE_IMAGE_ATTEMPTS=4
# E-Hentai 不需要登录：画廊列表 / 搜索 / 详情 / 图片页 / 元数据全都匿名可用，
# 所以同样没有 token 与 get_token.py。exhentai（里站）内容会直接返回 401，本项目不碰它。
# GitHub（github/run.py 入口）。api.github.com 在本机直连就通，所以只用根清单里的 httpx，
# 不借道 IP 池、不用 ECH、也没有自己的 requirements.txt。**这个变量是可选的**：
# 匿名就有 60 次/小时，配上 token 提到 5000 次/小时（search 是另一本账：匿名 10 次/小时，
# 认证后 30 次/分钟）。写个人访问令牌（ghp_... / github_pat_...），只加 Authorization 头。
GITHUB_TOKEN=
# 上游地址。改它就能把本服务指向 GitHub Enterprise（末尾斜杠会被自动去掉）。
GITHUB_API_URL=https://api.github.com
# 列表接口默认每页条数，夹在 1..100（100 是 GitHub 的硬上限，超了上游回 422）。
# 路由的 per_page 查询参数留空时就取这个值。
GITHUB_PER_PAGE=30
# 注意：github 站点**显式不使用代理**（客户端写死 trust_env=False），所以这里没有 GITHUB_PROXY。
# 实测同一台机器上走本机代理出口反而会撞在别人的额度上（同一个 /rate_limit：直连剩 56 次、
# 经代理剩 0 次），也就是说系统里配了 HTTP_PROXY / HTTPS_PROXY 也不会影响这个站点。
