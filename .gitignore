__pycache__/
*.pyc
.venv/
venv/
.env
tokens.json

# 离线 wheel 包（pip download -d wheels 生成的目录，体积大、随项目拷贝即可，不入库）
wheels/
pip-wheels/

# 本机自检截图等临时产物
web-check.png

# 个人数据目录（凭据 / 阅读历史 / 下载记录 / 收藏台账 / 页面配置；换机直接拷这个目录，不必入库）
data/

# 阅读历史（个人使用，跟着项目目录走，但不必入库）
history.jsonl
history.jsonl.tmp
_tmp_tests/

# 单元测试用的假凭据文件。测试优先写系统 TEMP；某些环境（TEMP 不可写 /
# 沙箱）会退回当前目录，于是落在项目根，这里兜住，避免污染工作区。
site_bridge_test_tokens.json
site_bridge_server_test_tokens.json
*_test_tokens.json

# 分享打包产物（用 README「打包与移植」里的命令随时重新生成）
dist/

# 开发时的临时探针、中间报告与离线 wheel（不属于项目代码；删掉不影响运行）
_scratch/

# pytest 在本机写缓存失败时留下的空目录
pytest-cache-files-*/
.pytest_cache/
